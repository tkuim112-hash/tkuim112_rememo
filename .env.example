# === LLM ===
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=cwchang/llama-3-taiwan-8b-instruct-128k:q4_k_m
# 換模型時務必同步調整，見 config.py ollama_num_ctx 註解
OLLAMA_NUM_CTX=24576

# === STT ===
STT_HOST=http://stt:8000
# 中文微調過的 Whisper checkpoint，interim（即時預覽）跟最終辨識（存檔/餵LLM）統一用這個
STT_MODEL=XA9/Belle-faster-whisper-large-v3-zh-punct

# === TTS ===
TTS_HOST=http://tts:8080

# === Stability ===
STABILITY_API_KEY=your_stability_key_here

# === OpenAI（gpt-image-2 生圖，2026-08-14起正式環境改用這個）===
OPENAI_API_KEY=your_openai_key_here

# === JWT (Unity 治療師登入) ===
JWT_SECRET=your_jwt_secret_here

# === CORS（允許呼叫後端的前端來源，逗號分隔）===
CORS_ORIGINS=http://localhost:3000,https://re-memo.com

# === 執行環境（development 才會開放 /docs /redoc /openapi.json，其餘一律視為 production 關閉）===
ENVIRONMENT=development

# === Database  ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=rememo

# === Frontend ===
FRONTEND_DATABASE_URL=postgresql://postgres:your_db_password_here@db:5432/rememo
SESSION_SECRET=your_session_secret_here
# 前端瀏覽器端要打的後端網址（build 時就會寫死進前端 JS，正式環境記得填公開網域）
NEXT_PUBLIC_API_URL=https://api.re-memo.com

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# === pgAdmin ===
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here

# === Qdrant ===
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=safe_reminiscence
QDRANT_API_KEY=your_qdrant_api_key_here
# Qdrant 備份加密密碼（qdrant-backup 容器用，遺失就無法解密還原，請妥善保管，不要外流）
QDRANT_BACKUP_PASSPHRASE=your_qdrant_backup_passphrase_here
EMBEDDING_MODEL=bge-m3

# === Anthropic ===
ANTHROPIC_API_KEY=sk-ant-...

# === Resend (忘記密碼寄信服務) ===
RESEND_API_KEY=your_resend_api_key_here
